------------------------------
FW1
config router static
    edit 0
        set dst 0.0.0.0/0
        set device port1
        set gateway 10.0.0.2
        next
    end
end
config system interface
    edit port1
        set mode static
        set ip 10.0.0.15/24
        next
    end
end
config system ha
    set mode a-p
    set group-id 1
    set group-name "cluster"
    set password "admin"
    set priority 200
    set override enable
    set hbdev "port2" 50 "port3" 50
end

